{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iptvwatchdog-curator",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "CURATOR_BUCKET",
      "bucket_name": "iptvwatchdog-curator"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
